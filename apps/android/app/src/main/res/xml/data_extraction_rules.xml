<?xml version="1.0" encoding="utf-8"?>
<!--
android:allowBackup="false" in the manifest already disables all built-in backup mechanisms
(cloud, adb, device-to-device) on every supported API level. This file is the modern,
API 31+-specific replacement lint recommends, expressing the same "exclude everything" intent
explicitly rather than relying solely on the deprecated allowBackup path for newer devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>

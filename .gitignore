# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Android / Gradle
apps/android/.gradle/
apps/android/build/
apps/android/*/build/
apps/android/local.properties
apps/android/.cxx/
apps/android/captures/
apps/android/*.apk
apps/android/*.aab

# Android Studio
*.iml
.idea/

# Native builds (AprilTag / other C/C++ dependencies)
apps/android/**/cmake-build-*/
*.so
*.dylib
*.dll

# Test output
*.profraw
coverage/
lcov.info

# Local libraries / SDK paths
local.properties
.gradle/

# Generated PDFs (Smart Pages, Notebook Designs) — not source, regenerated from layouts
*.generated.pdf
/tmp-pdf/

# Secrets — must never be committed; model API keys live only in platform keystores
*.env
.env.*
*.keystore
*.jks
secrets.*
